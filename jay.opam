license: "Apache-2.0"
homepage: "https://github.com/JHU-PL-Lab/jaylang"
bug-reports: "https://github.com/JHU-PL-Lab/jaylang/issues"
depends: [
  "dune" {>= "3.23"}
  "baby"
  "cmdliner" {>= "2.1"}
  "menhir" {>= "20180523"}
  "moonpool"
  "mtime"
  "nel"
  "ocaml" {>= "5.5"}
  "ppxlib" {>= "0.38"}
  "ppx_deriving"
  "psq"
  "z3"
  "alcotest" {with-test}
  "ppx_enumerate" {with-test}
  "ppx_sexp_conv" {with-test}
  "sexplib" {with-test}
  "landmarks" {with-dev-setup}
  "landmarks-ppx" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
